{
  "name": "@argszero/cordis-plugin-empty-response-guard",
  "description": "Empty-response guard for dsh: observes the llm/stream waterfall and reclassifies a reasoning-only completion (a stop with no text and no tool call) as EMPTY_RESPONSE, so the harness reports the failure and its retry policy can act instead of silently ending the turn. Reconciled with the in-tree guard family and AssistantStream's chunkHasVisibleText predicate. Compatible with dsh 0.1.2-rc.1 and the 0.1.5 line.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "guard",
    "empty-response",
    "reasoning",
    "retry"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"test/*.test.js\"",
    "prepublishOnly": "tsc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": false
    }
  }
}
